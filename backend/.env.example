BOT_TOKEN=
DATABASE_PATH=./data/app.db
STUDENT_REGISTRY_PATH=./data/student_registry.json
STUDENT_REGISTRY_PEPPER=change-this-to-a-long-random-secret
BSUIR_API_BASE_URL=https://iis.bsuir.by/api/v1
TELEGRAM_INIT_DATA_MAX_AGE=86400
VERIFICATION_ATTEMPTS_PER_HOUR=5
CORS_ORIGINS=http://localhost:8000,http://localhost:8080
TIMEZONE=Europe/Minsk
# Use the current public HTTPS URL. Telegram cannot open localhost.
WEB_APP_URL=
# Development only. Disable before publishing the application.
DEV_AUTH_ENABLED=false
DEV_TELEGRAM_ID=999000001
SESSION_SHORT_MINUTES=120
SESSION_REMEMBER_DAYS=30
LOGIN_ATTEMPTS_PER_HOUR=5
# Required only for the administrator CLI registry importer.
ADMIN_REGISTRY_TOKEN=
